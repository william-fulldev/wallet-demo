# Documento la configuración necesaria sin incluir credenciales reales.

# Identifico el entorno en el que desarrollo y pruebo el backend.
NODE_ENV=development

# Reservo este puerto para recibir las peticiones HTTP de mi API.
PORT=3000

# Dejo pendiente la dirección de MongoDB hasta configurar la base de datos.
MONGODB_URI=

# Secreto JWT para firmar tokens (debe tener al menos 64 caracteres en hexadecimal o texto aleatorio).
JWT_SECRET=

CORS_ORIGINS=http://localhost:8100,http://localhost:5173

REFRESH_TOKEN_DAYS=7
DEMO_MODE=false
FINNHUB_API_KEY=
COINGECKO_DEMO_API_KEY=
MARKET_CACHE_TTL_SECONDS=60

# Interruptor para permitir ingresos manuales de dinero (desactivado por defecto).
DEPOSITS_ENABLED=false
